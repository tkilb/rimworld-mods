# RimWorld Monorepo - Steam Deck (SteamOS) Environment Profile
# Reference configuration for Steam Deck (native or Proton).

MACHINE="steam-deck"

# RimWorld mod directory:
# Internal SSD default:
RIMWORLD_MODS_DIR="$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods"
# MicroSD Card alternative:
# RIMWORLD_MODS_DIR="/run/media/mmcblk0p1/steamapps/common/RimWorld/Mods"

# RimWorld configuration directory (ModsConfig.xml):
# Proton compatibility prefix default:
RIMWORLD_CONFIG_DIR="$HOME/.local/share/Steam/steamapps/compatdata/294100/pfx/drive_c/users/steamuser/AppData/LocalLow/Ludeon Studios/RimWorld by Ludeon Studios/Config"
# Native Linux alternative:
# RIMWORLD_CONFIG_DIR="$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/Config"

# SteamCMD executable
STEAMCMD_BIN="steamcmd"
