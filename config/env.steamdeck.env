# RimWorld Monorepo - Steam Deck (SteamOS) Environment Profile
# Reference configuration for Steam Deck (native or Proton).

MACHINE="steam-deck"

# RimWorld mod directory:
if [[ -d "/run/media/steam-drive/steamapps/common/RimWorld/Mods" ]]; then
  RIMWORLD_MODS_DIR="/run/media/steam-drive/steamapps/common/RimWorld/Mods"
elif [[ -d "$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods" ]]; then
  RIMWORLD_MODS_DIR="$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods"
else
  _sd_candidate="$(find /run/media -maxdepth 4 -type d -path '*/steamapps/common/RimWorld/Mods' 2>/dev/null | head -n 1 || true)"
  RIMWORLD_MODS_DIR="${_sd_candidate:-$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods}"
fi

# RimWorld configuration directory (ModsConfig.xml):
_proton_cfg="$HOME/.local/share/Steam/steamapps/compatdata/294100/pfx/drive_c/users/steamuser/AppData/LocalLow/Ludeon Studios/RimWorld by Ludeon Studios/Config"
_native_cfg="$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/Config"
if [[ -d "$_proton_cfg" ]]; then
  RIMWORLD_CONFIG_DIR="$_proton_cfg"
elif [[ -d "$_native_cfg" ]]; then
  RIMWORLD_CONFIG_DIR="$_native_cfg"
else
  RIMWORLD_CONFIG_DIR="$_native_cfg"
fi

# SteamCMD executable
STEAMCMD_BIN="steamcmd"
