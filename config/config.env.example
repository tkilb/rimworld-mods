# RimWorld Monorepo - Local Configuration Example
# Copy this file to config/local.env to override defaults for your environment.
# This file is gitignored — safe to store local values here.

# Target machine identifier ("linux-box", "steam-deck", or custom)
# MACHINE="linux-box"

# RimWorld active Mods directory:
# Arch Linux Desktop default:
# RIMWORLD_MODS_DIR="/mnt/gaming/SteamLibrary/steamapps/common/RimWorld/Mods"
# Steam Deck (Internal SSD) default:
# RIMWORLD_MODS_DIR="$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods"
# Steam Deck (MicroSD Card):
# RIMWORLD_MODS_DIR="/run/media/mmcblk0p1/steamapps/common/RimWorld/Mods"

# RimWorld Config directory (containing ModsConfig.xml):
# Arch Linux Desktop default:
# RIMWORLD_CONFIG_DIR="$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/Config"
# Steam Deck Proton Prefix default:
# RIMWORLD_CONFIG_DIR="$HOME/.local/share/Steam/steamapps/compatdata/294100/pfx/drive_c/users/steamuser/AppData/LocalLow/Ludeon Studios/RimWorld by Ludeon Studios/Config"
# Steam Deck Native Linux default:
# RIMWORLD_CONFIG_DIR="$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/Config"

# Steam Deck SSH alias — must match a Host entry in ~/.ssh/config
# Connection details (user, port, key) are managed entirely by ~/.ssh/config.
DECK_HOST="steamdeck"

# Remote path where this repo lives on the Steam Deck
DECK_REMOTE_DIR="~/.local/share/rimworld-mods"

# Optional SteamCMD binary path override
# STEAMCMD_BIN="steamcmd"
