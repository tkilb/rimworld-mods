# RimWorld Monorepo - Arch Linux Laptop (linux-book) Environment Profile
# Reference configuration for Arch Linux laptop development workstations.

MACHINE="linux-book"

# RimWorld native Linux mod installation directory (standard internal SSD path)
RIMWORLD_MODS_DIR="$HOME/.local/share/Steam/steamapps/common/RimWorld/Mods"
# Alternative external library path:
# RIMWORLD_MODS_DIR="/mnt/gaming/SteamLibrary/steamapps/common/RimWorld/Mods"

# RimWorld native Linux configuration directory (ModsConfig.xml)
RIMWORLD_CONFIG_DIR="$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/Config"

# Steam Deck SSH target details (matches Host in ~/.ssh/config)
DECK_HOST="steamdeck"
DECK_REMOTE_DIR="~/.local/share/rimworld-mods"

# SteamCMD executable
STEAMCMD_BIN="steamcmd"
