<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GeneSplicer</AssemblyName>
    <RootNamespace>GeneSplicer</RootNamespace>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>disable</Nullable>

    <!-- ── RimWorld managed DLL directory ──────────────────────────────────── -->
    <!-- Priority 1: explicit env override -->
    <RimWorldManagedDir Condition="'$(RIMWORLD_MANAGED_DIR)' != ''">$(RIMWORLD_MANAGED_DIR)</RimWorldManagedDir>
    <!-- Priority 2: /mnt/gaming Steam library -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' And Exists('/mnt/gaming/SteamLibrary/steamapps/common/RimWorld/RimWorldLinux_Data/Managed')">/mnt/gaming/SteamLibrary/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManagedDir>
    <!-- Priority 3: default Steam library -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed')">$(HOME)/.local/share/Steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManagedDir>

    <!-- ── 0Harmony.dll location ──────────────────────────────────────────── -->
    <HarmonyWorkshopBase Condition="Exists('/mnt/gaming/SteamLibrary/steamapps/workshop/content/294100/2009463077')">/mnt/gaming/SteamLibrary/steamapps/workshop/content/294100/2009463077</HarmonyWorkshopBase>
    <HarmonyWorkshopBase Condition="'$(HarmonyWorkshopBase)' == ''">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/2009463077</HarmonyWorkshopBase>
    <HarmonyDllPath Condition="Exists('$(HarmonyWorkshopBase)/Current/Assemblies/0Harmony.dll')">$(HarmonyWorkshopBase)/Current/Assemblies/0Harmony.dll</HarmonyDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' And Exists('$(HarmonyWorkshopBase)/1.5/Assemblies/0Harmony.dll')">$(HarmonyWorkshopBase)/1.5/Assemblies/0Harmony.dll</HarmonyDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' And Exists('$(HarmonyWorkshopBase)/1.4/Assemblies/0Harmony.dll')">$(HarmonyWorkshopBase)/1.4/Assemblies/0Harmony.dll</HarmonyDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' And Exists('$(RimWorldManagedDir)/0Harmony.dll')">$(RimWorldManagedDir)/0Harmony.dll</HarmonyDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="'$(HarmonyDllPath)' != ''">
      <HintPath>$(HarmonyDllPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
