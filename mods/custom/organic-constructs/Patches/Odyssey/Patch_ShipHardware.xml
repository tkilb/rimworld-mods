<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ════════════════════════════════════════════════════════════════════════
       Odyssey Gravship Hardware: Space-Efficient Synthesizer & Growth Cradle
       Conditionally loaded only when Ludeon.RimWorld.Odyssey is active.
       ════════════════════════════════════════════════════════════════════════ -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ludeon.RimWorld.Odyssey</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- 1. Auxiliary Shipboard Synthesizer (2x1 Bench) -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs</xpath>
          <value>
            <ThingDef ParentName="BenchBase">
              <defName>ShipConstructSynthesizer</defName>
              <label>auxiliary ship synthesizer</label>
              <description>A miniaturized 2x1 biological synthesis workstation designed for gravship bulkheads. Optimized for limited vessel power grids (350 W), it allows field replenishment of constructs from loaded master genome discs or base organic ingredients.</description>
              <thingClass>OrganicConstructs.Building_ShipConstructSynthesizer</thingClass>
              <graphicData>
                <texPath>Things/Building/ConstructSynthesizer/ConstructSynthesizer</texPath>
                <graphicClass>Graphic_Multi</graphicClass>
                <drawSize>(2.3, 1.2)</drawSize>
                <shadowData>
                  <volume>(1.8, 0.35, 0.59)</volume>
                  <offset>(0, 0, 0.08)</offset>
                </shadowData>
              </graphicData>
              <altitudeLayer>Building</altitudeLayer>
              <passability>PassThroughOnly</passability>
              <pathCost>50</pathCost>
              <castEdgeShadows>true</castEdgeShadows>
              <fillPercent>0.5</fillPercent>
              <canOverlapZones>false</canOverlapZones>
              <minifiedDef>MinifiedThing</minifiedDef>
              <statBases>
                <MaxHitPoints>280</MaxHitPoints>
                <WorkToBuild>3800</WorkToBuild>
                <Mass>25</Mass>
                <Flammability>0.4</Flammability>
              </statBases>
              <size>(2, 1)</size>
              <costList>
                <Steel>150</Steel>
                <Plasteel>40</Plasteel>
                <ComponentIndustrial>6</ComponentIndustrial>
              </costList>
              <comps>
                <li Class="CompProperties_Power">
                  <compClass>CompPowerTrader</compClass>
                  <basePowerConsumption>350</basePowerConsumption>
                  <idlePowerDraw>30</idlePowerDraw>
                  <shortCircuitInRain>true</shortCircuitInRain>
                </li>
                <li Class="CompProperties_Flickable"/>
              </comps>
              <inspectorTabs>
                <li>ITab_Bills</li>
              </inspectorTabs>
              <surfaceType>Item</surfaceType>
              <building>
                <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
              </building>
              <designationCategory>Biotech</designationCategory>
              <uiOrder>2610</uiOrder>
              <hasInteractionCell>true</hasInteractionCell>
              <interactionCellOffset>(0, 0, -1)</interactionCellOffset>
              <researchPrerequisites>
                <li>Construct_FieldBioproduction</li>
              </researchPrerequisites>
            </ThingDef>
          </value>
        </li>

        <!-- 2. Compact Growth Cradle (2x1 Bulkhead Growth Vat) -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs</xpath>
          <value>
            <ThingDef ParentName="BuildingBase">
              <defName>CompactGrowthVat</defName>
              <label>compact growth cradle</label>
              <description>A miniaturized 2x1 gestation cradle engineered to snap flush against gravship bulkheads. Consumes 200 W power and houses a single developing embryo or child in accelerated stasis, featuring an integrated neuro-imprint transceiver to stream doctrines during gestation.</description>
              <thingClass>Building_GrowthVat</thingClass>
              <containedPawnsSelectable>true</containedPawnsSelectable>
              <graphicData>
                <texPath>Things/Building/Misc/GrowthVat/GrowthVat</texPath>
                <graphicClass>Graphic_Multi</graphicClass>
                <drawSize>(2.2, 1.3)</drawSize>
                <shadowData>
                  <volume>(1.8, 0.5, 0.9)</volume>
                </shadowData>
              </graphicData>
              <altitudeLayer>Building</altitudeLayer>
              <passability>PassThroughOnly</passability>
              <pathCost>40</pathCost>
              <blockWind>true</blockWind>
              <castEdgeShadows>true</castEdgeShadows>
              <fillPercent>0.5</fillPercent>
              <canOverlapZones>false</canOverlapZones>
              <statBases>
                <MaxHitPoints>220</MaxHitPoints>
                <WorkToBuild>3200</WorkToBuild>
                <Mass>30</Mass>
                <Flammability>0.5</Flammability>
              </statBases>
              <size>(2, 1)</size>
              <costList>
                <Steel>120</Steel>
                <ComponentIndustrial>4</ComponentIndustrial>
              </costList>
              <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
              <comps>
                <li Class="CompProperties_Power">
                  <compClass>CompPowerTrader</compClass>
                  <basePowerConsumption>200</basePowerConsumption>
                </li>
                <li Class="CompProperties_Flickable"/>
                <li Class="OrganicConstructs.CompProperties_GrowthVatImprinter">
                  <imprintIntervalTicks>250</imprintIntervalTicks>
                  <xpPerImprintInterval>15</xpPerImprintInterval>
                  <imprintPassions>false</imprintPassions>
                </li>
              </comps>
              <designationCategory>Biotech</designationCategory>
              <uiOrder>2620</uiOrder>
              <hasInteractionCell>true</hasInteractionCell>
              <interactionCellOffset>(0, 0, -1)</interactionCellOffset>
              <defaultPlacingRot>South</defaultPlacingRot>
              <researchPrerequisites>
                <li>GrowthVats</li>
                <li>Construct_FieldBioproduction</li>
              </researchPrerequisites>
            </ThingDef>
          </value>
        </li>

        <!-- 3. Add ShipConstructSynthesizer to recipeUsers for all synthesis recipes -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="Recipe_SynthesizeBaseEmbryoFresh" or defName="Recipe_SynthesizeBaseEmbryoRecycled" or defName="Recipe_SynthesizeComplexEmbryoFresh" or defName="Recipe_SynthesizeComplexEmbryoRecycled" or defName="Construct_BatchRecycleEmbryo"]/recipeUsers</xpath>
          <value>
            <li>ShipConstructSynthesizer</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
