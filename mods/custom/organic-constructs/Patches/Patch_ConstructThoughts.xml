<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ════════════════════════════════════════════════════════════════════════
       Construct Asset Trait Nullification: Corpse Observation & Witnessing Death
       Nullifies observed corpses and death witnessing thoughts for constructs.
       ════════════════════════════════════════════════════════════════════════ -->

  <!-- Add Trait_ConstructAsset to nullifyingTraits for Core corpse observation and death witnessing -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThoughtDef[defName="ObservedLayingCorpse" or defName="ObservedLayingRottingCorpse" or defName="WitnessedDeathAlly" or defName="WitnessedDeathNonAlly" or defName="WitnessedDeathFamily"]/nullifyingTraits</xpath>
    <value>
      <li>Trait_ConstructAsset</li>
    </value>
  </Operation>

  <!-- Ideology: Nullify observed gibbet cage and skullspike -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ludeon.RimWorld.Ideology</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- ObservedGibbetCage -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThoughtDef[defName="ObservedGibbetCage"]/nullifyingTraits</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/ThoughtDef[defName="ObservedGibbetCage"]/nullifyingTraits</xpath>
            <value>
              <li>Trait_ConstructAsset</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThoughtDef[defName="ObservedGibbetCage"]</xpath>
            <value>
              <nullifyingTraits>
                <li>Trait_ConstructAsset</li>
              </nullifyingTraits>
            </value>
          </nomatch>
        </li>

        <!-- ObservedSkullspike -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThoughtDef[defName="ObservedSkullspike"]/nullifyingTraits</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/ThoughtDef[defName="ObservedSkullspike"]/nullifyingTraits</xpath>
            <value>
              <li>Trait_ConstructAsset</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThoughtDef[defName="ObservedSkullspike"]</xpath>
            <value>
              <nullifyingTraits>
                <li>Trait_ConstructAsset</li>
              </nullifyingTraits>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Core: Nullify insect meat eating thoughts -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThoughtDef[defName="AteInsectMeatDirect"]/nullifyingTraits</xpath>
    <match Class="PatchOperationAdd">
