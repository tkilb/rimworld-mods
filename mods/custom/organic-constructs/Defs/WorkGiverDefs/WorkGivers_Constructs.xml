<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGiver: Do Bills at Construct Synthesizer (Research / Intellectual)
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>DoBillsConstructSynthesizer</defName>
    <label>synthesize constructs at workstation</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Research</workType>
    <priorityInType>60</priorityInType>
    <fixedBillGiverDefs>
      <li>ConstructSynthesizer</li>
    </fixedBillGiverDefs>
    <verb>synthesize</verb>
    <gerund>synthesizing at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

