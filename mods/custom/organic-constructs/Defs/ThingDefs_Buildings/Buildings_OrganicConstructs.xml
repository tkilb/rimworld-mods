<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       Construct Synthesizer Workstation
       ════════════════════════════════════════════════════════════════════════ -->
  <ThingDef ParentName="BenchBase">
    <defName>ConstructSynthesizer</defName>
    <label>construct synthesizer</label>
    <description>An industrial biological workstation dedicated to the synthesis, cloning, and batch genome-imprinting of organic constructs (Base and Complex Constructs). Equipped with an integrated genome blueprint disc drive to imprint mass batches of synthetic embryo matrices, and biomass liquefaction tanks for recycling culled biological material.</description>
    <thingClass>OrganicConstructs.Building_ConstructSynthesizer</thingClass>
    <graphicData>
      <texPath>Things/Building/ConstructSynthesizer/ConstructSynthesizer</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5, 1.5)</drawSize>
      <shadowData>
        <volume>(2.8, 0.35, 0.59)</volume>
        <offset>(0, 0, 0.08)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Mass>35</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(3, 1)</size>
    <costList>
      <Steel>200</Steel>
      <Plasteel>50</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <surfaceType>Item</surfaceType>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2600</uiOrder>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -1)</interactionCellOffset>
    <researchPrerequisites>
      <li>Construct_FieldBioproduction</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Construct Stasis Pod (1x1 Vertical Hibernation Alcove)
       ════════════════════════════════════════════════════════════════════════ -->
  <ThingDef ParentName="BedBase">
    <defName>ConstructStasisPod</defName>
    <label>construct stasis pod</label>
    <description>A compact 1x1 vertical hibernation alcove designed exclusively for biological constructs. When supplied with 150 W of power, cryo-neuro flushes defragment construct synaptic pathways at an accelerated rate, completing a full stasis cycle in 36 hours (down from 48 hours in a basic bed). In addition, its internal shock-dampening buffer mitigates the cognitive trauma of premature awakening.</description>
    <thingClass>OrganicConstructs.Building_ConstructStasisPod</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/GrowthVat/GrowthVat</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.2, 1.2)</drawSize>
      <shadowData>
        <volume>(0.8, 0.4, 0.8)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.3</Flammability>
      <BedRestEffectiveness>1.0</BedRestEffectiveness>
      <Comfort>0.75</Comfort>
      <ImmunityGainSpeedFactor>1.1</ImmunityGainSpeedFactor>
    </statBases>
    <size>(1, 1)</size>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <bed_showSleeperBody>false</bed_showSleeperBody>
      <bed_healPerDay>4</bed_healPerDay>
      <bed_defaultMedical>false</bed_defaultMedical>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2605</uiOrder>
    <hasInteractionCell>false</hasInteractionCell>
    <researchPrerequisites>
      <li>Construct_FieldBioproduction</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Neural Scanner Pod
       ════════════════════════════════════════════════════════════════════════ -->
  <ThingDef ParentName="BuildingBase">
    <defName>NeuralScanner</defName>
    <label>neural scanner</label>
    <description>An enclosed biometric scanning pod engineered to record and digitize human synaptic topologies. Allows veteran colonists to export their combat proficiencies and labor doctrines onto neural imprint discs for growth vat construct programming.</description>
    <thingClass>OrganicConstructs.Building_NeuralScanner</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <graphicData>
      <texPath>Things/Building/NeuralScanner/NeuralScanner</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2, 2)</drawSize>
      <shadowData>
        <volume>(1.7, 0.8, 1.7)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>true</rotatable>
    <size>(2, 2)</size>
    <uiIconScale>0.56</uiIconScale>
    <canOverlapZones>false</canOverlapZones>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>50</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2500</uiOrder>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(1, 0, -1)</interactionCellOffset>
    <researchPrerequisites>
      <li>Construct_NeuralImprinting</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="OrganicConstructs.NeuralScannerExtension">
        <scanTicks>30000</scanTicks>
        <powerConsumptionScanning>1500</powerConsumptionScanning>
        <powerConsumptionIdle>200</powerConsumptionIdle>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
