<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 1. Space-rated Construct Crew Member -->
  <PawnKindDef ParentName="BasePlayerPawnKind" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Construct_CrewMember</defName>
    <label>construct</label>
    <defaultFactionDef>GravshipCrew</defaultFactionDef>
    <xenotypeSet>
      <xenotypeChances>
        <Construct_Base>999</Construct_Base>
      </xenotypeChances>
    </xenotypeSet>
    <useFactionXenotypes>false</useFactionXenotypes>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <apparelColor>(255,255,255)</apparelColor>
    <apparelTags Inherit="False">
      <li>Vacsuit</li>
    </apparelTags>
    <ignoreApparelAllowChance>true</ignoreApparelAllowChance>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>FullHead</bodyPartGroup>
        <requiredTag>Vacsuit</requiredTag>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Vacsuit</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelMoney>1500~2000</apparelMoney>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <backstoryFilters>
      <li>
        <categories>
          <li>Construct</li>
        </categories>
      </li>
    </backstoryFilters>
    <initialResistanceRange>0~0</initialResistanceRange>
    <initialWillRange>0~0</initialWillRange>
    <forcedTraits>
      <Psychopath>0</Psychopath>
      <Trait_ConstructAsset>0</Trait_ConstructAsset>
    </forcedTraits>
  </PawnKindDef>

  <!-- 2. Gravship Captain (Female Officer: High Intellectual, Medicine, Social, Crafting) -->
