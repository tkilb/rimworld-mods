<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>GenomeBlueprintDisk</defName>
    <label>genome blueprint disc</label>
    <description>A high-density optical Genome Blueprint Disc formatted with complete genomic sequencing data for Base &amp; Complex Constructs. Can be loaded into Construct Synthesizers to batch-imprint blank embryo matrices.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Blueprints/GenomeBlueprintDisk</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>350</MarketValue>
      <Mass>0.15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>BiotechGenetics</li>
    </tradeTags>
    <comps>
      <li Class="OrganicConstructs.CompProperties_GenomeBlueprint">
        <defaultTemplateLabel>Base Construct Template</defaultTemplateLabel>
      </li>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>NeuralBlueprintDisk</defName>
    <label>neural imprint disc</label>
    <description>A cryogenic neural imprint disc containing encoded synaptic pathways, combat reflexes, and skill doctrines extracted from a veteran colonist or master neural template. Used in Growth Vats to impart high-tier proficiencies during Base &amp; Complex Construct gestation.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Blueprints/NeuralBlueprintDisk</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>600</MarketValue>
      <Mass>0.15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>BiotechGenetics</li>
    </tradeTags>
    <comps>
      <li Class="OrganicConstructs.CompProperties_NeuralBlueprint">
        <defaultDoctrineTitle>Standard Combat Doctrine</defaultDoctrineTitle>
        <defaultSkillCap>14</defaultSkillCap>
      </li>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

</Defs>
