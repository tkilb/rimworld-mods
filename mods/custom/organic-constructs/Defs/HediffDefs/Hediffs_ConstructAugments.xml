<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <HediffDef Name="ConstructAugmentBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
  </HediffDef>

  <!-- Combat -->
  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_BasicCombatPackage</defName>
    <spawnThingOnRemoved>Construct_BasicCombatPackageItem</spawnThingOnRemoved>
    <label>basic combat package</label>
    <description>A basic biological neural bridge tailored for combat. Enhances targeting calculations, reflex routines, and boosts Shooting and Melee skills by +4.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <MeleeHitChance>4</MeleeHitChance>
          <MeleeDodgeChance>4</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_IntermediateCombatPackage</defName>
    <spawnThingOnRemoved>Construct_IntermediateCombatPackageItem</spawnThingOnRemoved>
    <label>intermediate combat package</label>
    <description>An intermediate biological neural bridge tailored for combat. Enhances targeting calculations, reflex routines, quickens aiming, and boosts Shooting and Melee skills by +6.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
          <MeleeHitChance>6</MeleeHitChance>
          <MeleeDodgeChance>6</MeleeDodgeChance>
          <AimingDelayFactor>-0.05</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_AdvancedCombatPackage</defName>
    <spawnThingOnRemoved>Construct_AdvancedCombatPackageItem</spawnThingOnRemoved>
    <label>advanced combat package</label>
    <description>An advanced biological neural bridge tailored for combat. Enhances targeting calculations, reflex routines, quickens aiming, increases move speed, and boosts Shooting and Melee skills by +8.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>8</ShootingAccuracyPawn>
          <MeleeHitChance>8</MeleeHitChance>
          <MeleeDodgeChance>8</MeleeDodgeChance>
          <AimingDelayFactor>-0.10</AimingDelayFactor>
          <MoveSpeed>0.20</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Biomedical -->
  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_BasicMedicalPackage</defName>
    <spawnThingOnRemoved>Construct_BasicMedicalPackageItem</spawnThingOnRemoved>
    <label>basic biomedical package</label>
    <description>A basic biological neural bridge loaded with bio-synthesis routines and medical protocols. Boosts Medicine and Crafting skills by +3 alongside tend quality, surgery success, synthesis speeds, and general labor.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.05</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.03</MedicalSurgerySuccessChance>
          <MedicalTendSpeed>0.10</MedicalTendSpeed>
          <GeneralLaborSpeed>0.05</GeneralLaborSpeed>
          <DrugSynthesisSpeed>0.10</DrugSynthesisSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_IntermediateMedicalPackage</defName>
    <spawnThingOnRemoved>Construct_IntermediateMedicalPackageItem</spawnThingOnRemoved>
    <label>intermediate biomedical package</label>
    <description>An intermediate biological neural bridge loaded with bio-synthesis routines and medical protocols. Boosts Medicine and Crafting skills by +5 alongside tend quality, surgery success, operation speed, and synthesis speeds.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.10</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.05</MedicalSurgerySuccessChance>
          <MedicalTendSpeed>0.20</MedicalTendSpeed>
          <MedicalOperationSpeed>0.10</MedicalOperationSpeed>
          <GeneralLaborSpeed>0.10</GeneralLaborSpeed>
          <DrugSynthesisSpeed>0.20</DrugSynthesisSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_AdvancedMedicalPackage</defName>
    <spawnThingOnRemoved>Construct_AdvancedMedicalPackageItem</spawnThingOnRemoved>
    <label>advanced biomedical package</label>
    <description>An advanced biological neural bridge loaded with bio-synthesis routines and medical protocols. Boosts Medicine and Crafting skills by +7 alongside elite tend quality, surgery success, rapid operations, and swift synthesis speeds.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.15</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.07</MedicalSurgerySuccessChance>
          <MedicalTendSpeed>0.30</MedicalTendSpeed>
          <MedicalOperationSpeed>0.20</MedicalOperationSpeed>
          <GeneralLaborSpeed>0.15</GeneralLaborSpeed>
          <DrugSynthesisSpeed>0.30</DrugSynthesisSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Industrial -->
  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_BasicIndustrialPackage</defName>
    <spawnThingOnRemoved>Construct_BasicIndustrialPackageItem</spawnThingOnRemoved>
    <label>basic industrial package</label>
    <description>A basic neural bridge tailored for industrial work. Boosts Construction, Mining, and Crafting skills by +2 alongside construction, mining, and general labor speeds.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.15</ConstructionSpeed>
          <ConstructSuccessChance>0.03</ConstructSuccessChance>
          <MiningSpeed>0.15</MiningSpeed>
          <MiningYield>0.03</MiningYield>
          <GeneralLaborSpeed>0.10</GeneralLaborSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_IntermediateIndustrialPackage</defName>
    <spawnThingOnRemoved>Construct_IntermediateIndustrialPackageItem</spawnThingOnRemoved>
    <label>intermediate industrial package</label>
    <description>An intermediate neural bridge tailored for industrial work. Boosts Construction, Mining, and Crafting skills by +4 alongside construction, mining, and general labor speeds.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.25</ConstructionSpeed>
          <ConstructSuccessChance>0.05</ConstructSuccessChance>
          <MiningSpeed>0.25</MiningSpeed>
          <MiningYield>0.05</MiningYield>
          <GeneralLaborSpeed>0.15</GeneralLaborSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_AdvancedIndustrialPackage</defName>
    <spawnThingOnRemoved>Construct_AdvancedIndustrialPackageItem</spawnThingOnRemoved>
    <label>advanced industrial package</label>
    <description>An advanced neural bridge tailored for industrial work. Boosts Construction, Mining, and Crafting skills by +6 alongside construction, mining, deep drilling, and general labor speeds.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.35</ConstructionSpeed>
          <ConstructSuccessChance>0.07</ConstructSuccessChance>
          <MiningSpeed>0.35</MiningSpeed>
          <MiningYield>0.07</MiningYield>
          <GeneralLaborSpeed>0.25</GeneralLaborSpeed>
          <DeepDrillingSpeed>0.20</DeepDrillingSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Laborer -->
  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_BasicLaborerPackage</defName>
    <spawnThingOnRemoved>Construct_BasicLaborerPackageItem</spawnThingOnRemoved>
    <label>basic laborer package</label>
    <description>A basic neural bridge tailored for cooking, plants, and animals. Boosts Cooking, Plants, and Animals skills by +2 alongside work speeds and butchery.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.10</CookSpeed>
          <PlantWorkSpeed>0.10</PlantWorkSpeed>
          <PlantHarvestYield>0.02</PlantHarvestYield>
          <TameAnimalChance>0.02</TameAnimalChance>
          <TrainAnimalChance>0.02</TrainAnimalChance>
          <ButcheryFleshSpeed>0.15</ButcheryFleshSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_IntermediateLaborerPackage</defName>
    <spawnThingOnRemoved>Construct_IntermediateLaborerPackageItem</spawnThingOnRemoved>
    <label>intermediate laborer package</label>
    <description>An intermediate neural bridge tailored for cooking, plants, and animals. Boosts Cooking, Plants, and Animals skills by +4 alongside work speeds, butchery, and hunting stealth.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.20</CookSpeed>
          <PlantWorkSpeed>0.20</PlantWorkSpeed>
          <PlantHarvestYield>0.04</PlantHarvestYield>
          <TameAnimalChance>0.04</TameAnimalChance>
          <TrainAnimalChance>0.04</TrainAnimalChance>
          <ButcheryFleshSpeed>0.25</ButcheryFleshSpeed>
          <HuntingStealth>0.10</HuntingStealth>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ConstructAugmentBase">
    <defName>Construct_AdvancedLaborerPackage</defName>
    <spawnThingOnRemoved>Construct_AdvancedLaborerPackageItem</spawnThingOnRemoved>
    <label>advanced laborer package</label>
    <description>An advanced neural bridge tailored for cooking, plants, and animals. Boosts Cooking, Plants, and Animals skills by +6 alongside work speeds, butchery, and animal gathering yields.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.30</CookSpeed>
          <PlantWorkSpeed>0.30</PlantWorkSpeed>
          <PlantHarvestYield>0.06</PlantHarvestYield>
          <TameAnimalChance>0.06</TameAnimalChance>
          <TrainAnimalChance>0.06</TrainAnimalChance>
          <ButcheryFleshSpeed>0.35</ButcheryFleshSpeed>
          <AnimalGatherYield>0.10</AnimalGatherYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Assimilation State -->
  <HediffDef>
    <defName>Construct_Assimilation</defName>
    <label>neural assimilation</label>
    <description>The construct's biological neural bus is actively integrating a newly installed bioware augment. Synaptic mapping requires temporary dormancy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.4, 0.2)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000~5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Interrupted Stasis -->
  <HediffDef>
    <defName>Construct_InterruptedStasis</defName>
    <label>interrupted stasis</label>
    <description>This construct was forcibly awakened from a hibernation cycle before neural and metabolic defragmentation was complete.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.2, 0.2)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000~180000</disappearsAfterTicks> <!-- 3 days -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <vomitMtbDays>1</vomitMtbDays>
      </li>
    </stages>
  </HediffDef>

</Defs>
