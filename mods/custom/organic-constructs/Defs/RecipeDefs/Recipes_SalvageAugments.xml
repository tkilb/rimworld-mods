    <jobString>Salvaging intermediate bioware augment.</jobString>
    <workAmount>1800</workAmount>
    <researchPrerequisite>Construct_BiowareIntermediate</researchPrerequisite>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Construct_IntermediateCombatPackageItem</li>
            <li>Construct_IntermediateMedicalPackageItem</li>
            <li>Construct_IntermediateIndustrialPackageItem</li>
            <li>Construct_IntermediateLaborerPackageItem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Construct_IntermediateCombatPackageItem</li>
        <li>Construct_IntermediateMedicalPackageItem</li>
        <li>Construct_IntermediateIndustrialPackageItem</li>
        <li>Construct_IntermediateLaborerPackageItem</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ComponentSpacer>1</ComponentSpacer>
      <Plasteel>15</Plasteel>
    </products>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Advanced Augment Salvage
       Recovers: 2x ComponentSpacer (100%), 25x Plasteel (50%)
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef ParentName="SalvageConstructAugmentBase">
    <defName>Salvage_ConstructAugment_Advanced</defName>
    <label>salvage advanced bioware augment</label>
    <description>Dismantle an unused advanced bioware augment package to reclaim its intact advanced components and reinforced plasteel casing. Recovers 2 advanced components and 25 plasteel. Biological tissue and chemical stabilizers are consumed in the process.</description>
    <jobString>Salvaging advanced bioware augment.</jobString>
    <workAmount>2400</workAmount>
    <researchPrerequisite>Construct_BiowareAdvanced</researchPrerequisite>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Construct_AdvancedCombatPackageItem</li>
            <li>Construct_AdvancedMedicalPackageItem</li>
            <li>Construct_AdvancedIndustrialPackageItem</li>
            <li>Construct_AdvancedLaborerPackageItem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Construct_AdvancedCombatPackageItem</li>
        <li>Construct_AdvancedMedicalPackageItem</li>
        <li>Construct_AdvancedIndustrialPackageItem</li>
        <li>Construct_AdvancedLaborerPackageItem</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
