<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       Abstract Base for Bioware Augment Salvage
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef Name="SalvageConstructAugmentBase" Abstract="True">
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
      <li>FabricationBench</li>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Basic Augment Salvage
       Recovers: 1x ComponentIndustrial (100%), 7x Plasteel (50%)
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef ParentName="SalvageConstructAugmentBase">
    <defName>Salvage_ConstructAugment_Basic</defName>
    <label>salvage basic bioware augment</label>
    <description>Dismantle an unused basic bioware augment package to reclaim its intact micro-circuitry and reinforced plasteel casing. Recovers 1 industrial component and 7 plasteel. Biological tissue and chemical stabilizers are consumed in the process.</description>
    <jobString>Salvaging basic bioware augment.</jobString>
    <workAmount>1200</workAmount>
    <researchPrerequisite>Construct_BiowareBasic</researchPrerequisite>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Construct_BasicCombatPackageItem</li>
            <li>Construct_BasicMedicalPackageItem</li>
            <li>Construct_BasicIndustrialPackageItem</li>
            <li>Construct_BasicLaborerPackageItem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Construct_BasicCombatPackageItem</li>
        <li>Construct_BasicMedicalPackageItem</li>
        <li>Construct_BasicIndustrialPackageItem</li>
        <li>Construct_BasicLaborerPackageItem</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Plasteel>7</Plasteel>
    </products>
  </RecipeDef>

