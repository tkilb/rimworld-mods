  <!-- Basic Combat -->
  <RecipeDef ParentName="Construct_SurgeryPackageBase">
    <defName>Construct_InstallBasicCombatPackage</defName>
    <label>install basic combat augment</label>
    <description>Install a bioware augment.</description>
    <workerClass>OrganicConstructs.Recipe_InstallConstructPackage</workerClass>
    <jobString>Installing bioware augment.</jobString>
    <workAmount>3000</workAmount>
    <skillRequirements><Medicine>4</Medicine></skillRequirements>
    <ingredients>
      <li><filter><categories><li>Medicine</li></categories></filter><count>2</count></li>
      <li><filter><thingDefs><li>Construct_BasicCombatPackageItem</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <categories><li>Medicine</li></categories>
      <thingDefs><li>Construct_BasicCombatPackageItem</li></thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts><li>Brain</li></appliedOnFixedBodyParts>
