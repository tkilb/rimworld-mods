<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Base Construct Embryo
       Directly synthesizes a Base Construct embryo from fresh organic stock.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeBaseEmbryoFresh</defName>
    <label>synthesize base construct embryo</label>
    <description>Synthesizes a Base Construct embryo from raw organic biomass, neutroamine, and medicine. Yields a construct embryo with locked construct baseline endogenes.</description>
    <jobString>Synthesizing base construct embryo.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeBaseEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Complex Construct Embryo
       Synthesizes a Complex Construct embryo from fresh organics, imprinted
       with the synthesizer's loaded genome blueprint disc.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeComplexEmbryoFresh</defName>
    <label>synthesize complex construct embryo</label>
    <description>Synthesizes a Complex Construct embryo from raw organic biomass, neutroamine, and medicine, directly imprinted with the genome encoded on the synthesizer's loaded master disc. Requires a loaded Genome Blueprint Disc.</description>
    <jobString>Synthesizing complex construct embryo.</jobString>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeComplexEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
    <researchPrerequisite>Construct_Foundations</researchPrerequisite>
  </RecipeDef>

</Defs>
