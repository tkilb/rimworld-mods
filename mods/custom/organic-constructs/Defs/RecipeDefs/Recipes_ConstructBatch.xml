<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Batch Apply Genome Blueprint
       Slices/imprints endogenes from the bench's loaded master blueprint disc
       onto an embryo.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Construct_BatchApplyBlueprint</defName>
    <label>splice embryo with loaded blueprint disc</label>
    <description>Applies the endogenetic caste matrix encoded on the synthesizer's loaded Genome Blueprint Disc to a blank or human embryo. The master disc remains safely installed in the synthesizer for subsequent batch production.</description>
    <jobString>Splicing embryo genetics.</jobString>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_BatchApplyBlueprint</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HumanEmbryo</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HumanEmbryo</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
    </skillRequirements>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Blank Embryo (Fresh Organics)
       Synthesizes a blank construct embryo from fresh organic stock.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeBlankEmbryoFresh</defName>
    <label>synthesize blank embryo (fresh organics)</label>
    <description>Synthesizes a blank synthetic embryo matrix from raw organic biomass, neutroamine, and medicine. Yields a donorless construct embryo matrix with locked construct baseline endogenes.</description>
    <jobString>Synthesizing blank construct embryo.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeBlankEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Blank Embryo (Recycled Biomass)
       Synthesizes a blank construct embryo using recycled Genetic Nutrient Paste.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeBlankEmbryoRecycled</defName>
    <label>synthesize blank embryo (recycled biomass)</label>
    <description>Synthesizes a blank synthetic embryo matrix utilizing recovered genetic nutrient paste, drastically reducing the raw biomass needed. Yields a donorless construct embryo matrix with locked construct baseline endogenes.</description>
    <jobString>Synthesizing blank construct embryo.</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeBlankEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>GeneticNutrientPaste</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>GeneticNutrientPaste</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Batch Biomass Liquefaction
       Recycles an embryo into Genetic Nutrient Paste.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Construct_BatchRecycleEmbryo</defName>
    <label>liquefy embryo biomass</label>
    <description>Liquefies culled embryonic biomass into concentrated genetic nutrient paste for growth vats.</description>
    <jobString>Liquefying embryo biomass.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workSkillLearnFactor>0.1</workSkillLearnFactor>
    <soundWorking>Recipe_ButcherCorpseFlesh</soundWorking>
    <workerClass>OrganicConstructs.Recipe_BatchRecycleEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HumanEmbryo</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HumanEmbryo</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GeneticNutrientPaste>1</GeneticNutrientPaste>
    </products>
    <skillRequirements>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

</Defs>
