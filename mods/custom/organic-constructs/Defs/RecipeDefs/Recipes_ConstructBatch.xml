<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Base Construct Embryo (Fresh Organics)
       Directly synthesizes a Base Construct embryo from fresh organic stock.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeBaseEmbryoFresh</defName>
    <label>synthesize base construct embryo (fresh organics)</label>
    <description>Synthesizes a Base Construct embryo from raw organic biomass, neutroamine, and medicine. Yields a construct embryo with locked construct baseline endogenes.</description>
    <jobString>Synthesizing base construct embryo.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeBaseEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       Recipe: Synthesize Base Construct Embryo (Recycled Biomass)
       Directly synthesizes a Base Construct embryo using recycled paste.
       ════════════════════════════════════════════════════════════════════════ -->
  <RecipeDef>
    <defName>Recipe_SynthesizeBaseEmbryoRecycled</defName>
    <label>synthesize base construct embryo (recycled biomass)</label>
    <description>Synthesizes a Base Construct embryo utilizing recovered genetic nutrient paste, drastically reducing the raw biomass needed. Yields a construct embryo with locked construct baseline endogenes.</description>
    <jobString>Synthesizing base construct embryo.</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.15</workSkillLearnFactor>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>OrganicConstructs.Recipe_SynthesizeBaseEmbryo</workerClass>
    <recipeUsers>
      <li>ConstructSynthesizer</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>GeneticNutrientPaste</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>PlantFoodRaw</li>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>GeneticNutrientPaste</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Intellectual>6</Intellectual>
      <Medicine>4</Medicine>
    </skillRequirements>
  </RecipeDef>

