       Combat Packages
       ════════════════════════════════════════════════════════════════════════ -->

  <RecipeDef ParentName="CraftConstructAugmentBase_Low">
    <defName>Craft_Construct_BasicCombatPackage</defName>
    <label>fabricate basic combat augment</label>
    <description>Synthesize a basic combat bioware augment package using organic substrate and neural reflex bridges.</description>
    <jobString>Fabricating basic combat augment.</jobString>
    <products>
      <Construct_BasicCombatPackageItem>1</Construct_BasicCombatPackageItem>
    </products>
