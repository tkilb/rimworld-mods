<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Ensure comps list exists on GrowthVat -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GrowthVat"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="GrowthVat"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <!-- Attach CompGrowthVatImprinter to vanilla GrowthVat -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="GrowthVat"]/comps</xpath>
    <value>
      <li Class="EugenicsProgram.CompProperties_GrowthVatImprinter">
        <imprintIntervalTicks>250</imprintIntervalTicks>
        <xpPerImprintInterval>15</xpPerImprintInterval>
        <imprintPassions>true</imprintPassions>
      </li>
    </value>
  </Operation>

</Patch>
