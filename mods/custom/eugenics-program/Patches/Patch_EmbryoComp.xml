<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Ensure comps list exists on HumanEmbryo -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="HumanEmbryo"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="HumanEmbryo"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <!-- Attach CompEmbryoQuality to HumanEmbryo with XML-configurable values -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="HumanEmbryo"]/comps</xpath>
    <value>
      <li Class="EugenicsProgram.CompProperties_EmbryoQuality">
        <baseDefectChance>0.05</baseDefectChance>
        <minScreeningSkill>8</minScreeningSkill>
        <dirtyRoomDefectMultiplier>2.0</dirtyRoomDefectMultiplier>
        <biomassYieldMultiplier>1.0</biomassYieldMultiplier>
      </li>
    </value>
  </Operation>

</Patch>
