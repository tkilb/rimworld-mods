<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>NeuralScanner</defName>
    <label>neural scanner</label>
    <description>An enclosed biometric scanning pod engineered to record and digitize human synaptic topologies. Allows veteran mentors to export their combat and labor doctrines directly onto high-density neural imprint discs for growth vat injection.</description>
    <thingClass>EugenicsProgram.Building_NeuralScanner</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <graphicData>
      <texPath>Things/Building/Production/SubcoreSoftscanner</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5, 2.5)</drawSize>
      <shadowData>
        <volume>(1.3, 0.6, 2.3)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>true</rotatable>
    <size>(1, 2)</size>
    <uiIconScale>0.56</uiIconScale>
    <canOverlapZones>false</canOverlapZones>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>50</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2500</uiOrder>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -1)</interactionCellOffset>
    <researchPrerequisites>
      <li>Eugenics_NeuralImprinting</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="EugenicsProgram.NeuralScannerExtension">
        <scanTicks>15000</scanTicks>
        <powerConsumptionScanning>1500</powerConsumptionScanning>
        <powerConsumptionIdle>200</powerConsumptionIdle>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
