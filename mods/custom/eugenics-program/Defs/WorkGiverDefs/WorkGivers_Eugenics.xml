<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGiver: Prenatal Genomic Screening
       Assigned to Doctors work type. Requires Medical 8+.
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>Eugenics_ScreenEmbryo</defName>
    <label>screen embryo genetics</label>
    <giverClass>EugenicsProgram.WorkGiver_ScreenEmbryo</giverClass>
    <workType>Doctor</workType>
    <priorityInType>50</priorityInType>
    <verb>screen</verb>
    <gerund>screening embryos</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGiver: Embryo Biomass Liquefaction
       Assigned to Doctors work type. Auto-queues for screened+defective embryos.
       Manual designation gizmo available for any embryo.
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>Eugenics_RecycleEmbryo</defName>
    <label>liquefy embryo biomass</label>
    <giverClass>EugenicsProgram.WorkGiver_RecycleEmbryo</giverClass>
    <workType>Doctor</workType>
    <priorityInType>40</priorityInType>
    <verb>liquefy</verb>
    <gerund>liquefying embryo biomass</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGiver: Do Bills at Embryo Splicing Bench (Research / Intellectual)
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>DoBillsEmbryoSplicingBench</defName>
    <label>splice embryos at workbench</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Research</workType>
    <priorityInType>60</priorityInType>
    <fixedBillGiverDefs>
      <li>EmbryoSplicingBench</li>
    </fixedBillGiverDefs>
    <verb>splice</verb>
    <gerund>splicing at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGiver: Do Bills at Embryo Splicing Bench (Doctor / Medical)
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>DoBillsEmbryoSplicingBenchDoctor</defName>
    <label>operate embryo splicing bench</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Doctor</workType>
    <priorityInType>45</priorityInType>
    <fixedBillGiverDefs>
      <li>EmbryoSplicingBench</li>
    </fixedBillGiverDefs>
    <verb>operate</verb>
    <gerund>operating at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- ════════════════════════════════════════════════════════════════════════
       WorkGivers: Haul Blueprint Discs to Eugenics Facilities (Hauling)
       ════════════════════════════════════════════════════════════════════════ -->
  <WorkGiverDef>
    <defName>HaulToNeuralScanner</defName>
    <label>haul to neural scanner</label>
    <giverClass>EugenicsProgram.WorkGiver_HaulToNeuralScanner</giverClass>
    <workType>Hauling</workType>
    <priorityInType>25</priorityInType>
    <verb>load</verb>
    <gerund>loading</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>HaulToEmbryoSplicingBench</defName>
    <label>haul to embryo splicing bench</label>
    <giverClass>EugenicsProgram.WorkGiver_HaulToEmbryoSplicingBench</giverClass>
    <workType>Hauling</workType>
    <priorityInType>25</priorityInType>
    <verb>load</verb>
    <gerund>loading</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>HaulToGrowthVatImprinter</defName>
    <label>haul to growth vat imprinter</label>
    <giverClass>EugenicsProgram.WorkGiver_HaulToGrowthVatImprinter</giverClass>
    <workType>Hauling</workType>
    <priorityInType>25</priorityInType>
    <verb>load</verb>
    <gerund>loading</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
