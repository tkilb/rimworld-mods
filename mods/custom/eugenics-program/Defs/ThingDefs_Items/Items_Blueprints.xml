<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>GenomeBlueprintDisk</defName>
    <label>genome blueprint disc</label>
    <description>A high-density optical data storage cartridge formatted with complete genomic sequencing data for a human construct caste. Can be stored in Gene Banks, inserted into Gene Assemblers to replicate gene sequences, or loaded into Growth Vats.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Resource/SubcoreRegular</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>350</MarketValue>
      <Mass>0.15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>BiotechGenetics</li>
    </tradeTags>
    <comps>
      <li Class="EugenicsProgram.CompProperties_GenomeBlueprint">
        <maxStoredGenes>30</maxStoredGenes>
        <defaultTemplateLabel>Construct Caste</defaultTemplateLabel>
        <marketValuePerGene>150</marketValuePerGene>
      </li>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>NeuralBlueprintDisk</defName>
    <label>neural imprint disc</label>
    <description>A cryogenic neural imprint disc containing encoded synaptic pathways, combat reflexes, and skill doctrines extracted from a veteran colonist or master neural template. Used in Growth Vats to impart high-tier proficiencies during construct gestation.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Resource/SubcoreHigh</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>600</MarketValue>
      <Mass>0.15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>BiotechGenetics</li>
    </tradeTags>
    <comps>
      <li Class="EugenicsProgram.CompProperties_NeuralBlueprint">
        <defaultDoctrineTitle>Standard Combat Doctrine</defaultDoctrineTitle>
        <defaultSkillCap>14</defaultSkillCap>
        <maxPassions>3</maxPassions>
        <marketValuePerSkillPoint>40</marketValuePerSkillPoint>
      </li>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

</Defs>
