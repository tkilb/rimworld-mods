<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <HediffDef Name="Eugenics_ConstructAugmentBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
  </HediffDef>

  <!-- Combat -->
  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_BasicCombatPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_BasicCombatPackage</defName>Item</spawnThingOnRemoved>
    <label>basic combat package</label>
    <description>A basic cybernetic neural bridge tailored for combat. Enhances targeting calculations and reflex routines.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_IntermediateCombatPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_IntermediateCombatPackage</defName>Item</spawnThingOnRemoved>
    <label>intermediate combat package</label>
    <description>An intermediate cybernetic neural bridge tailored for combat.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <MeleeHitChance>4</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_AdvancedCombatPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_AdvancedCombatPackage</defName>Item</spawnThingOnRemoved>
    <label>advanced combat package</label>
    <description>An advanced cybernetic neural bridge tailored for combat.</description>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
          <MeleeHitChance>6</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Medical -->
  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_BasicMedicalPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_BasicMedicalPackage</defName>Item</spawnThingOnRemoved>
    <label>basic medical package</label>
    <description>A basic neural bridge loaded with medical procedures.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.03</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.03</MedicalSurgerySuccessChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_IntermediateMedicalPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_IntermediateMedicalPackage</defName>Item</spawnThingOnRemoved>
    <label>intermediate medical package</label>
    <description>An intermediate neural bridge loaded with medical procedures.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.05</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.05</MedicalSurgerySuccessChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_AdvancedMedicalPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_AdvancedMedicalPackage</defName>Item</spawnThingOnRemoved>
    <label>advanced medical package</label>
    <description>An advanced neural bridge loaded with medical procedures.</description>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendQuality>0.07</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.07</MedicalSurgerySuccessChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Industrial -->
  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_BasicIndustrialPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_BasicIndustrialPackage</defName>Item</spawnThingOnRemoved>
    <label>basic industrial package</label>
    <description>A basic neural bridge tailored for industrial work.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.15</ConstructionSpeed>
          <ConstructSuccessChance>0.03</ConstructSuccessChance>
          <MiningSpeed>0.15</MiningSpeed>
          <MiningYield>0.03</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_IntermediateIndustrialPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_IntermediateIndustrialPackage</defName>Item</spawnThingOnRemoved>
    <label>intermediate industrial package</label>
    <description>An intermediate neural bridge tailored for industrial work.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.25</ConstructionSpeed>
          <ConstructSuccessChance>0.05</ConstructSuccessChance>
          <MiningSpeed>0.25</MiningSpeed>
          <MiningYield>0.05</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_AdvancedIndustrialPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_AdvancedIndustrialPackage</defName>Item</spawnThingOnRemoved>
    <label>advanced industrial package</label>
    <description>An advanced neural bridge tailored for industrial work.</description>
    <stages>
      <li>
        <statOffsets>
          <ConstructionSpeed>0.35</ConstructionSpeed>
          <ConstructSuccessChance>0.07</ConstructSuccessChance>
          <MiningSpeed>0.35</MiningSpeed>
          <MiningYield>0.07</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Laborer -->
  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_BasicLaborerPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_BasicLaborerPackage</defName>Item</spawnThingOnRemoved>
    <label>basic laborer package</label>
    <description>A basic neural bridge tailored for cooking, plants, and animals.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.10</CookSpeed>
          <PlantWorkSpeed>0.10</PlantWorkSpeed>
          <PlantHarvestYield>0.02</PlantHarvestYield>
          <TameAnimalChance>0.02</TameAnimalChance>
          <TrainAnimalChance>0.02</TrainAnimalChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_IntermediateLaborerPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_IntermediateLaborerPackage</defName>Item</spawnThingOnRemoved>
    <label>intermediate laborer package</label>
    <description>An intermediate neural bridge tailored for cooking, plants, and animals.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.20</CookSpeed>
          <PlantWorkSpeed>0.20</PlantWorkSpeed>
          <PlantHarvestYield>0.04</PlantHarvestYield>
          <TameAnimalChance>0.04</TameAnimalChance>
          <TrainAnimalChance>0.04</TrainAnimalChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="Eugenics_ConstructAugmentBase">
    <defName>Eugenics_AdvancedLaborerPackage</defName>
    <spawnThingOnRemoved><defName>Eugenics_AdvancedLaborerPackage</defName>Item</spawnThingOnRemoved>
    <label>advanced laborer package</label>
    <description>An advanced neural bridge tailored for cooking, plants, and animals.</description>
    <stages>
      <li>
        <statOffsets>
          <CookSpeed>0.30</CookSpeed>
          <PlantWorkSpeed>0.30</PlantWorkSpeed>
          <PlantHarvestYield>0.06</PlantHarvestYield>
          <TameAnimalChance>0.06</TameAnimalChance>
          <TrainAnimalChance>0.06</TrainAnimalChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Assimilation State -->
  <HediffDef>
    <defName>Eugenics_ConstructAssimilation</defName>
    <label>neural assimilation</label>
    <description>The construct's biological neural bus is actively integrating a newly installed augment package. Synaptic mapping requires temporary dormancy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.4, 0.2)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000~5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Interrupted Stasis -->
  <HediffDef>
    <defName>Eugenics_InterruptedStasis</defName>
    <label>interrupted stasis</label>
    <description>This construct was forcibly awakened from a hibernation cycle before neural and metabolic defragmentation was complete.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.2, 0.2)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000~180000</disappearsAfterTicks> <!-- 3 days -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <vomitMtbDays>1</vomitMtbDays>
      </li>
    </stages>
  </HediffDef>

  <JobDef>
    <defName>Eugenics_EnterConstructStasis</defName>
    <driverClass>EugenicsProgram.JobDriver_ConstructStasis</driverClass>
    <reportString>entering stasis.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>

  <GeneDef>
    <defName>Gene_ConstructHibernation</defName>
    <label>construct hibernation</label>
    <description>This construct is capable of entering a long-term stasis cycle to defragment neural pathways and reset metabolic buildup.</description>
    <geneClass>EugenicsProgram.Gene_ConstructHibernation</geneClass>
    <iconPath>UI/Icons/Genes/Gene_ConstructHibernation</iconPath> <!-- Might be missing, but engine handles it -->
    <displayCategory>Miscellaneous</displayCategory>
  </GeneDef>

</Defs>
